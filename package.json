{
  "name": "dsh-mineru-win7",
  "version": "0.1.0-dev.1",
  "description": "Python 3.8 plugin scaffold for self-hosted MinerU legacy Tasks and Office Gateway.",
  "license": "MIT",
  "private": true,
  "dsh": {
    "bundle": {"patch": "cordis.patch.yml"},
    "python": {
      "apiVersion": 1,
      "sourceRoot": "python",
      "entry": "mineru_win7.plugin:MinerUPlugin",
      "minPythonVersion": [3, 8, 10],
      "minHostVersion": [0, 1, 5],
      "dependencies": []
    },
    "release": {
      "formatVersion": 1,
      "files": [
        "package.json", "cordis.patch.yml", "README.md", "LICENSE",
        "docs/architecture.md", "docs/ROADMAP.md",
        "docs/research/2026-11-10-mineru-self-hosted-plugin-assessment.md",
        "python/mineru_win7/__init__.py", "python/mineru_win7/config.py",
        "python/mineru_win7/errors.py", "python/mineru_win7/plugin.py",
        "python/mineru_win7/service.py", "python/mineru_win7/tools.py",
        "python/mineru_win7/providers/__init__.py",
        "python/mineru_win7/providers/base.py",
        "python/mineru_win7/providers/legacy_tasks.py"
      ]
    }
  }
}
